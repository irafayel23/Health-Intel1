{
  "name": "health-intel-backend",
  "version": "1.0.0",
  "description": "Backend API for Health-Intel Municipal Health Intelligence System",
  "main": "server.js",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "start": "node server.js",
    "deploy:check": "node scripts/check-deployment.js",
    "test:first-fixes": "node --test tests/first-fixes.test.js",
    "test:phase-two": "node --test tests/first-fixes.test.js tests/phase-two.test.js",
    "data:review": "node scripts/prepare-forecast-data.js --review",
    "data:prepare": "node scripts/prepare-forecast-data.js",
    "test:normalization": "node scripts/run-tests.js --normalization",
    "db:normalize:prepare": "node scripts/prepare-normalization-copy.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "archiver-zip-encrypted": "^2.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.15.0"
  }
}
