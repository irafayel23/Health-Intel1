# Copy to .env in this folder. Keep the real .env private.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=health_intel
PORT=3000
# Local defaults retain separate frontend/API serving. See docs/deployment_guide.md.
# HOST=127.0.0.1
# NODE_ENV=production
# PUBLIC_ORIGIN=https://health-intel.example.org
# SERVE_FRONTEND=true
# TRUST_PROXY=loopback

# Production requires a random key of at least 32 characters.
# Development can leave this blank to use the private local signing key.
JWT_SECRET=

# Must match the Firebase Web project's projectId. Only Google's public keys are fetched.
FIREBASE_PROJECT_ID=health-intel-2a0ed

# Gmail app-password setup, or use SMTP_HOST/SMTP_PORT instead of SMTP_SERVICE.
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Optional overrides: PYTHON_PATH and MYSQLDUMP_PATH.
# Maximum simultaneous Python forecasts (1 by default for the 1 GiB VM).
# Raise only after measuring memory; valid values are 1 through 4.
FORECAST_MAX_CONCURRENT=1
