# TEMPLATE ONLY: copy reviewed values into private server/.env on the host.
# Do not overwrite the current local .env or publish the resulting private file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://health-intel.example.org
SERVE_FRONTEND=true
# Suitable only for Caddy on the same computer. Never use unrestricted true.
TRUST_PROXY=loopback
TZ=Asia/Manila

# Keep MySQL on this host or a reviewed local tunnel. Remote DB TLS is not configured.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=health_intel
DB_USER=health_intel_app
DB_PASSWORD=
JWT_SECRET=
FIREBASE_PROJECT_ID=health-intel-2a0ed

# Configure privately and test real delivery before account onboarding.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Install the declared dependencies in this virtual environment on the target OS.
PYTHON_PATH=/opt/health-intel/server/.venv/bin/python
MYSQLDUMP_PATH=/usr/bin/mysqldump
# One Python worker at a time on the current 1 GiB VM.
FORECAST_MAX_CONCURRENT=1
